# Visit/click insights for /biodata — all optional. Missing vars just
# disable that piece (e.g. no Telegram vars = no pings, still logs to Redis).

# Upstash Redis (free tier) — stores recent page views / Instagram taps
# for the /biodata/insights dashboard. Create one at upstash.com or via
# Vercel's Storage > Marketplace Database Providers, then copy the REST
# credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram bot for real-time pings — message @BotFather to create a bot
# and get TELEGRAM_BOT_TOKEN, then message your new bot once and hit
# https://api.telegram.org/bot<token>/getUpdates to find TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password for the /biodata/insights dashboard. Pick your own value.
INSIGHTS_PASSWORD=
